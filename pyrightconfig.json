{
  "include": [
    "whshr",
    "tests",
    "scripts"
  ],
  "exclude": [
    "**/__pycache__",
    "extracted",
    "samples",
    "battles",
    "logs",
    "saves"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.14",
  "typeCheckingMode": "off",
  "reportUndefinedVariable": "error",
  "reportAttributeAccessIssue": "none",
  "reportCallIssue": "error",
  "reportIndexIssue": "error",
  "reportMissingImports": "error",
  "reportOptionalMemberAccess": "none",
  "disableTaggedHints": true,
  "strict": [
    "whshr/paths.py",
    "whshr/battle_events.py",
    "whshr/clock.py",
    "whshr/script.py",
    "whshr/formation.py",
    "whshr/rules.py",
    "whshr/animation.py",
    "whshr/engine.py",
    "whshr/combat.py",
    "whshr/interpreter.py",
    "whshr/battle_grid.py",
    "whshr/battle_log.py",
    "whshr/image.py",
    "whshr/rnc.py",
    "whshr/assets.py",
    "whshr/catalog.py",
    "whshr/cache.py",
    "whshr/sprites.py",
    "whshr/legacy.py",
    "whshr/glue_fonts.py",
    "whshr/glue.py",
    "whshr/campaign_runtime.py",
    "whshr/controlpanel.py",
    "whshr/cutscene.py",
    "whshr/glue_animation.py",
    "whshr/glue_palette.py",
    "whshr/launcher/__main__.py",
    "whshr/launcher/battles.py",
    "whshr/launcher/config.py",
    "whshr/launcher/discovery.py",
    "whshr/launcher/engine_launch.py",
    "whshr/launcher/validate.py",
    "whshr/launcher/gui.py",
    "whshr/pbx.py",
    "whshr/picking.py",
    "whshr/roster.py",
    "whshr/payments.py",
    "whshr/smacker.py",
    "whshr/si.py"
  ]
}
