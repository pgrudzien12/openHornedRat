__pycache__/
*.pyc

# Data extracted from game files (renders and battle atlas) - local only, do not distribute.
samples/
battles/
extracted/
screenshots/

# Local virtual environment for the runtime frontend (requirements-engine.txt).
.venv/

# Local editor and environment configuration.
.env
.vscode/

# Machine-specific launcher with a local installation path.
run-local.sh

# Battle logs (whshr.battle_log): JSON Lines recordings of real battles, contain game data - local only.
logs/

# Engine saves (whshr.roster write_company/write_march): player-specific campaign state - local only.
saves/

# Temporary git worktrees of parallel agent sessions.
.claude/worktrees/

# Native build output.
build/
dist/
install.log

# Local renders of game art (root-level images) - do not distribute.
/*.png
